utoRefreshControls":null,"showRefreshControl":true},"overflow":"auto","delayLoad":false,"panelTitle":null,"PrimaryContainer":true},"panelB":{"type":"panel","name":"detail","ContentType":null,"data":null,"reloadOnConnectionChange":false,"panelHeaders":{"scope":"","refreshEnabled":true,"refreshOptions":"","autoRefreshControls":{"time":"10","timeVisible":true,"timeOptions":[1,5,10,20,60],"countdownVisible":true},"showRefreshControl":true},"overflow":"auto","delayLoad":false,"panelTitle":null,"PrimaryContainer":false},"direction":"h","splitPercent":null,"allowResize":true,"maxSize":null,"styleOverride":""}}],"elementAction":null,"elementSubNodes":null,"rootCallBack":null,"filterList":null,"elementSubNodeDirection":null},{"DBMS":null,"minVersion":0,"minFixPack":0,"maxVersion":0,"feature":"","noFeature":"","context":"","notContext":"","nodeType":"LINE","delayLoad":"false","GUID":"","reloadOnConnectionChange":false,"replacement":false,"tag":"","elementID":null,"elementValue":"Installs","elementActionScript":null,"elementFloatingLink":null,"elementLinkList":null,"elementPageWindows":null,"elementAction":null,"elementSubNodes":null,"rootCallBack":null,"filterList":null,"elementSubNodeDirection":null},{"DBMS":null,"minVersion":0,"minFixPack":0,"maxVersion":0,"feature":"","noFeature":"","context":"","notContext":"","nodeType":"LEAF","delayLoad":"false","GUID":"","reloadOnConnectionChange":false,"replacement":false,"tag":"","elementID":null,"elementValue":"Install Statement Monitoring","elementActionScript":null,"elementFloatingLink":null,"elementLinkList":[],"elementPageWindows":{"reloadOnConnectionChange":false,"target":"_final","title":"","info":"","leftMenu":null,"raiseToTop":true,"windowStage":null,"windowType":"NORMAL","windowOptionType":"","panelHeaders":null,"content":{"type":"panel","name":"Tutorial","ContentType":"LINK","data":{"target":"_self","window":"_self","windowStage":null,"formList":[],"type":"ACTION","data":{"baseDirectory":null,"address":null,"parameters":{"action":"tutorial","tutorialName":"","script":"<!--\n  Author: Peter Prib\n  Copyright Frygma Pty Ltd (ABN 90 791 388 622 2009) 2013 All rights reserved.\n\n  Licensed under the Apache License, Version 2.0 (the \"License\");\n  you may not use this file except in compliance with the License.\n  You may obtain a copy of the License at\n\n      http:\/\/www.apache.org\/licenses\/LICENSE-2.0\n\n  Unless required by applicable law or agreed to in writing, software\n  distributed under the License is distributed on an \"AS IS\" BASIS,\n  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n  See the License for the specific language governing permissions and\n  limitations under the License.\n  \n-->\n<tutorial name=\"Setup Statement Monitor\" autoPlayTime=\"5\">\n\t<flowRestriction>freewithchecks<\/flowRestriction>\n    <closeAction \/>\n    <openAction \/>\n    <globalCodeHighlightOptions highlightCode = \"true\" \/>\n    <WMDConfig\/>\n    <pageList>\n    \t <page name=\"Enable Statement Monitoring\" type=\"general\">\n\t\t\t<entryAction\/>\n            <contentText>\n<![CDATA[\n<h2>Setup Statement Monitoring<\/h2>\n<p\/>\nFirst edit the postgresql.conf by adding or removing the comment tag (# character) from the following line:\n<p\/>\nshared_preload_libraries = 'pg_stat_statements'\n<p\/>\nRunning the SQL in the ad hoc window will display the location of the configuration file and create required object.\n<p\/>\nOnce completed then restart PostgreSQL.\n<h3>Additional Settings<\/h3>\n<p\/>\nThe following addtional settings can be changed in the configuration file.\n<pre>\npg_stat_statements.max = 1000\npg_stat_statements.track = top # top,all,none\npg_stat_statements.save = off\n<pre>\n]]>\n            <\/contentText>\n            <SQLText><![CDATA[\nselect name, setting, unit from pg_settings where name='config_file'\n@\ncreate extension pg_stat_statements\n@\n]]>\n\t\t\t<\/SQLText>\n            <SQLExecutionOptions xml=\"false\" clob=\"false\" blob=\"false\" dbclob=\"false\" termChar=\"@\"\n\t\t\t\tcursor=\"forward\" commitPerStmt=\"true\" numRowReturned=\"100\"\/>\n        <\/page>\n\n    \t <page name=\"Uninstall\" type=\"last\" autoPlay=\"false\">\n            <contentText>\n<![CDATA[\n<h2>Uninstall Statement Monitor<\/h2>\n<p\/>\nEdit the postgresql.conf commenting out (# character) the following or removing pg_stat_statements from the list:\n<p\/>\n# shared_preload_libraries = 'pg_stat_statements'\n<p\/>\nRunning the SQL in the ad hoc window will display the location of the configurtation file and drop object.\n<p\/>\nOnce completed then restart PostgreSQL.\n]]>\n           <\/contentText>\n            <SQLText>\n<![CDATA[\nselect name, setting, unit from pg_settings where name='config_file'\n@\ndrop extension pg_stat_statements\n@\n]]>\n            <\/SQLText>\n            <SQLExecutionOptions xml=\"false\" clob=\"false\" blob=\"false\" dbclob=\"false\" termChar=\"@\"\n\t\t\t\tcursor=\"forward\" commitPerStmt=\"true\" numRowReturned=\"100\"\/>\n        <\/page>\n    <\/pageList>\n<\/tutorial>"}}},"reloadOnConnectionChange":false,"panelHeaders":null,"overflow":"auto","delayLoad":false,"panelTitle":null,"PrimaryContainer":true}},"elementAction":null,"elementSubNodes":null,"rootCallBack":null,"filterList":null,"elementSubNodeDirection":null}],"rootCallBack":null,"filterList":null,"elementSubNodeDirection":null},{"DBMS":"ssh","minVersion":0,"minFixPack":0,"maxVersion":0,"feature":"","noFeature":"","context":"","notContext":"","nodeType":"BRANCH","delayLoad":"false","GUID":"","reloadOnConnectionChange":false,"replacement":false,"tag":"","elementID":null,"elementValue":"Monitors","elementActionScript":null,"elementFloatingLink":null,"elementLinkList":null,"elementPageWindows":null,"elementAction":null,"elementSubNodes":[{"DBMS":null,"minVersion":0,"minFixPack":0,"maxVersion":0,"feature":"","noFeature":"","context":"","notContext":"","nodeType":"LEAF","delayLoad":"false","GUID":"","reloadOnConnectionChange