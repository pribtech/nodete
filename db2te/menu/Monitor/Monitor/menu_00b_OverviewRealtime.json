{
	"description": "Monitor Overview Realtime",
	"requires": {
		"minVersion": 9.5,
		"maxVersion": 9.5
	},
	"pageWindows": [
		{
			"target": "_active",
			"title": "Monitor Overview",
			"info": "Monitoring overview",
			"panelHeaders": {
				"autoRefreshControls": {
					"time": "10",
					"timeOptions": [
						1,
						5,
						10,
						20,
						60
					],
					"countdownVisible": true
				}
			},
			"content": {
				"type": "splitPane",
				"splitPercent": "0.5",
				"panelA": {
					"type": "splitPane",
					"direction": "v",
					"splitPercent": "0.5",
					"panelA": {
						"type": "panel",
						"name": "DB",
						"content": {
							"link": {
								"type": "action",
								"target": "_self",
								"window": "_self",
								"parameters": {
									"table": "Performance/topdatabase",
									"action": "chart",
									"refresh": "prepend",
									"$chartName": "DB",
									"$chartTitle": "Database",
									"$type": "line",
									"$xAxis": "snapshot_timestamp",
									"$yAxis": "direct_reads,direct_writes,lock_escals,deadlocks,lock_escals,sort_heap_allocated,total_sorts,pool_data_l_reads,pool_index_l_reads",
									"$legend": "hide",
									"$yScale": "EXPONENTIAL",
									"$highlight": "first",
									"maxResultsToFetch": "100"
								}
							}
						}
					},
					"panelB": {
						"type": "panel",
						"name": "CPU",
						"content": {
							"link": {
								"type": "action",
								"target": "_self",
								"window": "_self",
								"parameters": {
									"table": "Monitor/sysResourcesRow",
									"action": "chart",
									"refresh": "prepend",
									"$chartName": "CPU",
									"$chartTitle": "CPU",
									"$type": "line",
									"$xAxis": "SAMPLE_TS",
									"$yAxis": "CPU_TOTAL,CPU_ONLINE,CPU_LOAD_SHORT,CPU_LOAD_MEDIUM,CPU_LOAD_LONG,CPU_USAGE_TOTAL",
									"$legend": "hide",
									"$yScale": "EXPONENTIAL",
									"$highlight": "first",
									"maxResultsToFetch": "100"
								}
							}
						}
					}
				},
				"panelB": {
					"type": "splitPane",
					"direction": "v",
					"splitPercent": "0.5",
					"panelA": {
						"type": "panel",
						"name": "bufferpool",
						"content": {
							"link": {
								"type": "action",
								"target": "_self",
								"window": "_self",
								"parameters": {
									"table": "Performance/topbufferpool",
									"action": "chart",
									"refresh": "prepend",
									"$chartName": "Bufferpool",
									"$chartTitle": "Buffer pools",
									"$type": "line",
									"$xAxis": "snapshot_timestamp",
									"$yAxis": "files_closed,direct_reads,direct_writes,pool_data_l_reads,pool_data_p_reads,pool_index_l_reads,pool_index_p_reads",
									"$delta": "direct_reads,direct_writes,pool_async_data_reads,pool_async_data_writes,pool_async_index_reads,pool_async_index_writes,pool_data_l_reads,pool_data_p_reads,pool_data_writes,pool_index_l_reads,pool_index_p_reads,pool_index_writes,pool_no_victim_buffer,pool_temp_data_l_reads,pool_temp_data_p_reads,pool_temp_index_l_reads,pool_temp_index_p_reads,unread_prefetch_pages,vectored_ios,files_closed",
									"$legend": "hide",
									"$grouping": "bp_name",
									"$yScale": "EXPONENTIAL",
									"$highlight": "first",
									"maxResultsToFetch": "1000"
								}
							}
						}
					},
					"panelB": {
						"type": "panel",
						"name": "DBM",
						"content": {
							"link": {
								"type": "action",
								"target": "_self",
								"window": "_self",
								"parameters": {
									"table": "Performance/snapDBM",
									"action": "chart",
									"refresh": "prepend",
									"$chartName": "Instance",
									"$chartTitle": "Instance",
									"$type": "line",
									"$xAxis": "SNAPSHOT_TIMESTAMP",
									"$yAxis": "AGENTS_CREATED_EMPTY_POOL,AGENTS_WAITING_ON_TOKEN,PIPED_SORTS_REQUESTED,PIPED_SORTS_ACCEPTED",
									"$delta": "POST_THRESHOLD_SORTS,PIPED_SORTS_REQUESTED,PIPED_SORTS_ACCEPTED,AGENTS_REGISTERED,AGENTS_WAITING_ON_TOKEN,AGENTS_FROM_POOL,AGENTS_CREATED_EMPTY_POOL,AGENTS_STOLEN,GW_TOTAL_CONS,GW_CUR_CONS,GW_CONS_WAIT_HOST,GW_CONS_WAIT_CLIENT,POST_THRESHOLD_HASH_JOINS,NUM_GW_CONN_SWITCHES",
									"$legend": "hide",
									"$yScale": "EXPONENTIAL",
									"$highlight": "first",
									"maxResultsToFetch": "100"
								}
							}
						}
					}
				}
			}
		}
	]
}
