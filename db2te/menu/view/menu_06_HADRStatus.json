{
	"description": "HADR Status",
	"requires": {
		"DBMS": "DB2",
		"feature": "hadr"
	},
	"pageWindows": [
		{
			"target": "_active",
			"panelHeaders": {
				"autoRefreshControls": {
					"time": "10",
					"timeOptions": [
						1,
						5,
						10,
						20,
						60
					],
					"countdownVisible": true
				}
			},
			"content": {
				"type": "splitPane",
				"panelA": {
					"type": "panel",
					"name": "main",
					"content": {
						"link": {
							"type": "action",
							"target": "_self",
							"window": "_self",
							"parameters": {
								"table": "HADR/snaphadr",
								"action": "list_table",
								"refresh": "prepend",
								"maxResultsToFetch": "100"
							}
						}
					},
					"primaryContainer": true
				},
				"panelB": {
					"type": "panel",
					"name": "detail"
				}
			}
		}
	]
}
