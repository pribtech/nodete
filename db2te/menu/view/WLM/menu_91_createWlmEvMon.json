										"parameterType": "fixed",
										"title": "",
										"transform": "",
										"value": "CREATE EVENT MONITOR DB2ACTIVITIES\n    FOR ACTIVITIES\n    WRITE TO TABLE\n    ACTIVITY (TABLE ACTIVITY_DB2ACTIVITIES\n              IN ?TABLESPACE?\n              PCTDEACTIVATE 100),\n    ACTIVITYSTMT (TABLE ACTIVITYSTMT_DB2ACTIVITIES\n                  IN ?TABLESPACE?\n                  PCTDEACTIVATE 100),\n    ACTIVITYVALS (TABLE ACTIVITYVALS_DB2ACTIVITIES\n                  IN ?TABLESPACE?\n                  PCTDEACTIVATE 100),\n    CONTROL (TABLE CONTROL_DB2ACTIVITIES\n             IN ?TABLESPACE?\n             PCTDEACTIVATE 100)\n    AUTOSTART",
										"defaultValue": "",
										"check": null,
										"xpathBaseNode": "",
										"xpathName": "",
										"xpathValue": ""
									},
