										"$type": "fixed",
										"type": "parameter",
										"name": "SQL[1]",
										"parameterType": "fixed",
										"title": "",
										"transform": "",
										"value": "CREATE EVENT MONITOR DB2STATISTICS\n    FOR STATISTICS\n    WRITE TO TABLE\n    SCSTATS (TABLE SCSTATS_DB2STATISTICS\n             IN ?TABLESPACE?\n             PCTDEACTIVATE 100),\n    WCSTATS (TABLE WCSTATS_DB2STATISTICS\n             IN ?TABLESPACE?\n             PCTDEACTIVATE 100),\n    WLSTATS (TABLE WLSTATS_DB2STATISTICS\n             IN ?TABLESPACE?\n             PCTDEACTIVATE 100),\n    QSTATS  (TABLE QSTATS_DB2STATISTICS\n             IN ?TABLESPACE?\n             PCTDEACTIVATE 100),\n    HISTOGRAMBIN (TABLE HISTOGRAMBIN_DB2STATISTICS\n                  IN ?TABLESPACE?\n                  PCTDEACTIVATE 100),\n    CONTROL (TABLE CONTROL_DB2STATISTICS\n             IN ?TABLESPACE?\n             PCTDEACTIVATE 100)\n    AUTOSTART",
										"defaultValue": "",
										"check": null,
										"xpathBaseNode": "",
										"xpathName": "",
										"xpathValue": ""
									},
									{
										"$name": "SQL[2]",
										"$type": "fixed",
										"type": "parameter",
										"name": "SQL[2]",
										"parameterType": "fixed",
										"title": "",
										"transform": "",
										"value": "CREATE EVENT MONITOR DB2THRESHOLDVIOLATIONS\n    FOR THRESHOLD VIOLATIONS\n    WRITE TO TABLE\n    THRESHOLDVIOLATIONS (TABLE THRESHOLDVIOLATIONS_DB2THRESHOLDVIOLATIONS\n                         IN ?TABLESPACE?\n                         PCTDEACTIVATE 100),\n    CONTROL (TABLE CONTROL_DB2THRESHOLDVIOLATIONS\n             IN ?TABLESPACE?\n             PCTDEACTIVATE 100)\n    AUTOSTART",
